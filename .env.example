# Server-side only. Never use NEXT_PUBLIC_ for this key.
OPENROUTER_API_KEY=

# Model for follow-up chat and the written differential.
# Change this to switch models, then restart `npm run dev`.
# google/gemini-2.5-flash is often blocked in Hong Kong ("not available in your region").
# The server then tries qwen/qwen3.6-flash and deepseek/deepseek-v4.1-flash.
# OPENROUTER_FALLBACK_MODELS=qwen/qwen3.6-flash,deepseek/deepseek-v4.1-flash
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional. Image reading uses this model. If empty, OPENROUTER_MODEL is used.
# It must accept image_url parts on OpenRouter (for example openai/gpt-4o or google/gemini-2.5-flash).
OPENROUTER_VISION_MODEL=

# Sent as OpenRouter HTTP-Referer and X-Title.
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Hb Pattern Bench Chat
